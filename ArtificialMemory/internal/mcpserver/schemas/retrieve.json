{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "spaces": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Explicit selected space.",
        "maxLength": 128,
        "minLength": 1
      },
      "maxItems": 1000,
      "minItems": 1
    },
    "all_spaces": {
      "type": "boolean",
      "default": false,
      "description": "Explicit account-wide search; mutually exclusive with nonempty spaces."
    },
    "topic_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Topic/root ID: use this to reconstruct topic history.",
        "maxLength": 64,
        "minLength": 1
      },
      "maxItems": 100
    },
    "span_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Individual span ID; returns ancestry, not a claim of full topic history.",
        "maxLength": 64,
        "minLength": 1
      },
      "maxItems": 100
    },
    "external_ref": {
      "type": "string",
      "description": "Exact root external reference in selected spaces.",
      "maxLength": 256
    },
    "keywords": {
      "type": "string",
      "description": "At most 32 whitespace-separated keyword phrases; literal conjunctions, no FTS expressions.",
      "maxLength": 512
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "All supplied tags must match.",
        "maxLength": 64,
        "minLength": 1
      },
      "maxItems": 32
    },
    "kinds": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "topic",
          "context",
          "proposal",
          "decision",
          "note",
          "retraction"
        ]
      },
      "maxItems": 6
    },
    "occurred": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time",
          "description": "Inclusive RFC3339 instant."
        },
        "before": {
          "type": "string",
          "format": "date-time",
          "description": "Exclusive RFC3339 instant."
        },
        "calendar": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start_date": {
              "type": "string",
              "format": "date",
              "description": "Inclusive YYYY-MM-DD."
            },
            "end_date": {
              "type": "string",
              "format": "date",
              "description": "Exclusive YYYY-MM-DD."
            },
            "timezone": {
              "type": "string",
              "description": "IANA timezone, default America/New_York.",
              "maxLength": 128
            }
          },
          "required": [
            "start_date",
            "end_date"
          ]
        }
      },
      "description": "Half-open range. Use calendar or instant bounds, never both. Date filters select matches; required older ancestors remain visible.",
      "not": {
        "anyOf": [
          {
            "required": [
              "calendar",
              "from"
            ]
          },
          {
            "required": [
              "calendar",
              "before"
            ]
          }
        ]
      }
    },
    "recorded": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time",
          "description": "Inclusive RFC3339 instant."
        },
        "before": {
          "type": "string",
          "format": "date-time",
          "description": "Exclusive RFC3339 instant."
        },
        "calendar": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start_date": {
              "type": "string",
              "format": "date",
              "description": "Inclusive YYYY-MM-DD."
            },
            "end_date": {
              "type": "string",
              "format": "date",
              "description": "Exclusive YYYY-MM-DD."
            },
            "timezone": {
              "type": "string",
              "description": "IANA timezone, default America/New_York.",
              "maxLength": 128
            }
          },
          "required": [
            "start_date",
            "end_date"
          ]
        }
      },
      "description": "Half-open range. Use calendar or instant bounds, never both. Date filters select matches; required older ancestors remain visible.",
      "not": {
        "anyOf": [
          {
            "required": [
              "calendar",
              "from"
            ]
          },
          {
            "required": [
              "calendar",
              "before"
            ]
          }
        ]
      }
    },
    "order": {
      "type": "string",
      "enum": [
        "chronological",
        "newest",
        "relevance"
      ],
      "description": "Default: chronological for topic/reference, relevance for keywords, newest otherwise."
    },
    "limit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "default": 20,
      "description": "Matching entries per page; zero uses default."
    },
    "context_limit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 200,
      "default": 100,
      "description": "Ancestor records per support page; zero uses default."
    },
    "link_limit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 200,
      "default": 100,
      "description": "Typed relationship references per support page; zero uses default."
    },
    "cursor": {
      "type": "string",
      "description": "Use next_cursor with the identical query until complete. Later appends require a fresh query. Expand linked trees explicitly.",
      "maxLength": 4096
    }
  },
  "oneOf": [
    {
      "required": [
        "spaces"
      ],
      "properties": {
        "all_spaces": {
          "const": false
        }
      }
    },
    {
      "required": [
        "all_spaces"
      ],
      "properties": {
        "all_spaces": {
          "const": true
        }
      },
      "not": {
        "required": [
          "spaces"
        ]
      }
    }
  ]
}
