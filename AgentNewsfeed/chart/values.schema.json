{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "hostname",
    "imagePullSecrets",
    "existingServiceAccountName",
    "identity",
    "persistence",
    "resources",
    "initImage",
    "ingress",
    "tls",
    "thumbnailHosts",
    "provenance",
    "maintenance"
  ],
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "digest"
      ],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "const": "registry.lab.vvivid.dev/products/agent-newsfeed"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "hostname": {
      "const": "newsfeed.vvivid.dev"
    },
    "imagePullSecrets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "existingServiceAccountName": {
      "type": "string",
      "minLength": 1
    },
    "identity": {
      "type": "object",
      "required": [
        "issuer",
        "webClientID",
        "existingSecret",
        "gatewayIssuer",
        "gatewayAudience",
        "mcpClientIDs",
        "nativeClientIDs",
        "existingGatewayJWKS"
      ],
      "additionalProperties": false,
      "properties": {
        "issuer": {
          "const": "https://auth.rd.vvivid.dev/realms/vvivid-rd"
        },
        "webClientID": {
          "const": "newsfeed-web"
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "gatewayIssuer": {
          "const": "https://mcp.rd.lab.vvivid.dev"
        },
        "gatewayAudience": {
          "const": "agent-newsfeed-mcp"
        },
        "mcpClientIDs": {
          "const": "newsfeed-chatgpt"
        },
        "nativeClientIDs": {
          "$comment": "Empty, or 1-16 comma-separated IDs of [A-Za-z0-9._-]. The not-pattern rejects any 257-character run without a comma, limiting each ID to 256 characters. The newsfeed.nativeClientIDs template helper rejects repeated IDs and the web or MCP client.",
          "type": "string",
          "pattern": "^([A-Za-z0-9._-]+(,[A-Za-z0-9._-]+){0,15})?$",
          "not": {
            "pattern": "[^,]{257}"
          }
        },
        "existingGatewayJWKS": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "persistence": {
      "type": "object",
      "required": [
        "claimName",
        "storageClassName",
        "size"
      ],
      "additionalProperties": false,
      "properties": {
        "claimName": {
          "type": "string",
          "pattern": "^agent-newsfeed-[a-z0-9-]+$"
        },
        "storageClassName": {
          "const": "rd-local-retain"
        },
        "size": {
          "const": "5Gi"
        }
      }
    },
    "resources": {
      "type": "object",
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "type": "object",
          "required": [
            "cpu",
            "memory"
          ],
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string",
              "pattern": "^[1-9][0-9]*m$"
            },
            "memory": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(Mi|Gi)$"
            }
          }
        },
        "limits": {
          "type": "object",
          "required": [
            "cpu",
            "memory"
          ],
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string",
              "pattern": "^[1-9][0-9]*m$"
            },
            "memory": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(Mi|Gi)$"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "initImage": {
      "const": "docker.io/library/postgres:17-bookworm@sha256:839fbb5a4942a7758dd93e18b42ea5649807491a0545b5eeeb8f0b8bb11857a5"
    },
    "ingress": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "tls": {
      "type": "object",
      "required": [
        "productionEnabled",
        "stagingIssuer",
        "productionIssuer",
        "privateSecretName"
      ],
      "additionalProperties": false,
      "properties": {
        "productionEnabled": {
          "type": "boolean"
        },
        "stagingIssuer": {
          "const": "letsencrypt-staging"
        },
        "productionIssuer": {
          "const": "letsencrypt-production"
        },
        "privateSecretName": {
          "const": "tls-rd-edge"
        }
      }
    },
    "thumbnailHosts": {
      "type": "string",
      "maxLength": 4096
    },
    "provenance": {
      "type": "object",
      "required": [
        "sourceSha"
      ],
      "properties": {
        "sourceSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "maintenance": {
      "type": "boolean"
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingSecret",
        "model",
        "outputFormat",
        "voices"
      ],
      "properties": {
        "existingSecret": {
          "type": "string",
          "pattern": "^$|^agent-newsfeed-[a-z0-9-]+$"
        },
        "model": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,64}$"
        },
        "outputFormat": {
          "type": "string",
          "pattern": "^mp3_[0-9]{5}_[0-9]{2,3}$"
        },
        "voices": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "elevenlabs_voice_id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,31}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "description": {
                "type": "string",
                "maxLength": 120
              },
              "elevenlabs_voice_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9]{10,64}$"
              }
            }
          }
        }
      }
    }
  }
}
