# Optional local configuration. The application reads the environment, not this file.
SHOPPING_HTTP_ADDR=127.0.0.1:8090
SHOPPING_SHUTDOWN_TIMEOUT=10s
SHOPPING_DB_PATH=data/shopping.sqlite
SHOPPING_DB_BUSY_TIMEOUT=2s

# Optional as a complete bundle; partial identity configuration fails startup.
# These client IDs are preparation names, not proof of Keycloak registration.
# SHOPPING_ORIGIN=https://shopping.vvivid.dev
# SHOPPING_OIDC_ISSUER=https://ssh-mcp.vvivid.dev/realms/sshmcp
# SHOPPING_WEB_CLIENT_ID=shopping-web
# SHOPPING_WEB_CLIENT_SECRET_FILE=/run/secrets/shopping-web-client
# SHOPPING_API_AUDIENCE=https://shopping.vvivid.dev/api/v1
# SHOPPING_MCP_AUDIENCE=https://shopping.vvivid.dev/mcp
# SHOPPING_MCP_CLIENT_IDS=shopping-codex,shopping-chatgpt
# SHOPPING_SESSION_KEYS_FILE=/run/secrets/shopping-session-keys.json

# Optional shared-gateway MCP trust. Set all three or none; keep existing identity
# settings. When enabled /mcp rejects direct external bearer tokens.
# SHOPPING_GATEWAY_ISSUER=https://mcp.example.com
# SHOPPING_GATEWAY_AUDIENCE=shopping-mcp
# SHOPPING_GATEWAY_JWKS_FILE=/etc/mcp-gateway/public.jwks.json
