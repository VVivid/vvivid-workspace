# Copy to a protected .env (chmod 600); the application reads environment variables.
# These example domains/clients do not create real provider or gateway resources.
VOCAB_ORIGINS=https://vocab.example.test,https://vocab.private.example.test
VOCAB_OIDC_ISSUER=https://id.example.test/realms/personal
VOCAB_WEB_CLIENT_ID=vocabbank-web
VOCAB_WEB_CLIENT_SECRET_FILE=/protected/vocabbank/client-secret
VOCAB_API_AUDIENCE=https://vocab.example.test/api/v1
VOCAB_SESSION_KEYS_FILE=/protected/vocabbank/session-keys.json
VOCAB_MCP_MODE=direct
VOCAB_MCP_RESOURCE=https://vocab.private.example.test/mcp
VOCAB_MCP_AUDIENCE=https://vocab.private.example.test/mcp
VOCAB_MCP_CLIENT_IDS=vocabbank-agent
# In gateway mode only, use VOCAB_MCP_AUDIENCE=vocabbank-mcp and set both:
# VOCAB_GATEWAY_ISSUER=https://gateway.example.test
# VOCAB_GATEWAY_JWKS_FILE=/protected/vocabbank/gateway-public.jwks.json
