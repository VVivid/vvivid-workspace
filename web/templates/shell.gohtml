{{define "shell"}}<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="light">
  <title>{{.Current.Title}} · Shopping</title>
  <link rel="stylesheet" href="/static/app.css">
</head>
<body class="min-h-dvh bg-background text-foreground antialiased">
  <a class="skip-link" href="#content">Skip to content</a>
  <div class="shopping-app mx-auto w-full bg-white">
    <header class="flex items-center gap-3">
      <span class="app-icon grid place-items-center rounded-xl" aria-hidden="true">
        <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 7h12l2 14H4L6 7Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
      </span>
      <h1 class="text-2xl font-semibold tracking-tight">Shopping</h1>
    </header>
    <nav class="segmented-tabs grid grid-cols-4 gap-1 rounded-xl p-1" aria-label="Shopping views">
      {{range .Pages}}
      <a
        class="flex min-h-11 items-center justify-center rounded-lg text-xs font-medium{{if eq .Path $.Current.Path}} selected{{end}}"
        href="{{.Path}}"
        {{if eq .Path $.Current.Path}}aria-current="page"{{end}}
      >{{.Title}}</a>
      {{end}}
    </nav>
    <main id="content" tabindex="-1">
      <h2 class="text-sm font-semibold">{{.Current.Title}}</h2>
      <div class="empty-state flex flex-col items-center text-center">
        <svg class="mb-4" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 7h12l2 14H4L6 7Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
        <p class="max-w-64 text-sm leading-relaxed">{{.Current.Message}}</p>
        {{if .SignedIn}}
        <form method="post" action="/auth/logout" class="mt-4">
          <input type="hidden" name="csrf_token" value="{{.CSRF}}">
          <button type="submit" class="min-h-11 rounded-lg px-4 text-sm font-medium">Sign out</button>
        </form>
        {{else if .SignIn}}
        <a href="/auth/login" class="mt-4 flex min-h-11 items-center rounded-lg px-4 text-sm font-medium">Sign in</a>
        {{end}}
      </div>
    </main>
  </div>
</body>
</html>{{end}}
