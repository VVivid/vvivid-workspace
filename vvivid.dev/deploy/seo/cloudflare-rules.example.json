{
  "preview_noindex": {
    "phase": "http_response_headers_transform",
    "rule": {
      "description": "Keep the separate public preview out of search indexes",
      "expression": "http.host eq \"preview.vvivid.dev\"",
      "action": "rewrite",
      "action_parameters": {
        "headers": {
          "x-robots-tag": {"operation": "set", "value": "noindex, follow"}
        }
      },
      "enabled": true
    }
  },
  "www_redirect": {
    "phase": "http_request_dynamic_redirect",
    "rule": {
      "description": "Canonical www to apex with the original path and query",
      "expression": "http.host eq \"www.vvivid.dev\"",
      "action": "redirect",
      "action_parameters": {
        "from_value": {
          "status_code": 301,
          "target_url": {"expression": "concat(\"https://vvivid.dev\", http.request.uri.path)"},
          "preserve_query_string": true
        }
      },
      "enabled": true
    }
  }
}
